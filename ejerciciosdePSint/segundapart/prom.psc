Algoritmo prom
	Escribir "hola Mundo"
	Escribir "ingrese su primera nota"
	Leer nota1
	Escribir nota1
	Escribir "ingrese su segunda nota"
	Leer nota2
	Escribir nota2
	Escribir "ingrese su tercera nota"
	Leer nota3
	Escribir nota3
	promedio <-(nota1 + nota2 + nota3)/3
	Escribir "este es el promedio de las 3 notas ",promedio
	//ahora decidimos si aprobo o reprobo
	Si promedio >= 61 Entonces
		Escribir "aprobado"
	SiNo
		Escribir "reprobado"
	FinSi
FinAlgoritmo
